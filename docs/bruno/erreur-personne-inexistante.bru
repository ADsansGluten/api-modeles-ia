meta {
  name: Erreur - personne inexistante
  type: http
  seq: 17
}

get {
  url: {{baseUrl}}/api/personnes/999999
  body: none
  auth: none
}

tests {
  test("Réponse 404", function () {
    expect(res.status).to.equal(404);
  });
  test("Message cohérent", function () {
    expect(res.body.error).to.equal("Personne introuvable");
  });
}