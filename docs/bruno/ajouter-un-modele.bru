meta {
  name: Ajouter un modèle valide
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/ai-models
  body: json
  auth: none
}

body:json {
  {
    "title": "Modèle de test",
    "editor": "Test Labs",
    "releaseYear": 2025,
    "genre": "LLM",
    "rating": 7.5
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("modelId", res.body.id);
  }
}

tests {
  test("Réponse 201", function () {
    expect(res.status).to.equal(201);
  });
  test("Le modèle créé a un id", function () {
    expect(res.body.id).to.be.a("number");
  });
}