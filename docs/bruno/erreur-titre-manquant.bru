meta {
  name: Erreur - ajouter sans titre
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/ai-models
  body: json
  auth: none
}

body:json {
  {
    "title": "",
    "editor": "Test Labs",
    "releaseYear": 2025,
    "genre": "LLM",
    "rating": 7
  }
}

tests {
  test("Réponse 400", function () {
    expect(res.status).to.equal(400);
  });
  test("Message cohérent", function () {
    expect(res.body.error).to.equal("Données invalides");
    expect(res.body.details).to.include("Le titre est obligatoire");
  });
}